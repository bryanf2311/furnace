rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return request.auth.uid == uid;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    // Users: anyone signed in can read the directory; only admins (or self on create) can write.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid);
      allow update: if isAdmin() || (isSelf(uid) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // Meetings: anyone signed in can read; only admins can write.
    match /meetings/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();

      // RSVPs: any signed-in user can write only their own RSVP field.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['rsvps'])
        && request.resource.data.rsvps.diff(resource.data.rsvps).affectedKeys()
             .hasOnly([request.auth.uid]);
    }

    // Ideas: anyone signed in can read and create; only creator or admin can delete; any signed-in user can vote (toggle one field).
    match /ideas/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn()
        && (
          // Voting: only the votes.<uid> key may change (set or deleted).
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
            && (request.resource.data.votes.diff(resource.data.votes).affectedKeys()
                  .hasOnly([request.auth.uid])
                || request.resource.data.votes.keys().hasAll([request.auth.uid])))
          || isAdmin()
        );
      allow delete: if isAdmin() || resource.data.createdBy == request.auth.uid;
    }

    // Chat rooms. Two collections effectively: one document per message, with a `room` field
    // either "leaders" (admin-only) or "members" (everyone).
    match /messages/{id} {
      // Read: anyone signed in can read members; only admins can read leaders.
      allow read: if isSignedIn() && (resource.data.room == 'members' || isAdmin());

      // List: same rule.
      allow list: if isSignedIn()
        && (request.query.limit <= 200)
        && (isAdmin() || request.query.filters.size() == 0
            || (request.query.filters[0][0] == 'room' && request.query.filters[0][2] == 'members'));

      // Create: any signed-in user can post. The room must be "members", or "leaders" if admin.
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.room in ['leaders', 'members']
        && (request.resource.data.room == 'members' || isAdmin());

      // Update / delete: author or admin.
      allow update, delete: if isAdmin() || resource.data.uid == request.auth.uid;
    }

    // "Currently reading" — one document per user, keyed by uid.
    // Anyone signed in can read any of them; users can only write their own.
    match /currentReads/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'title', 'author', 'note', 'updatedAt']);
      allow delete: if isSelf(uid) || isAdmin();
    }

    // Recommended readings — leaders curate a list for the group.
    // Anyone signed in can read; only admins can write.
    match /recommendations/{id} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && request.resource.data.addedBy == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Polls — leaders create, anyone signed in votes (one option per user).
    match /polls/{id} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        || (
          // Voting: only votes.<uid> key changes.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
          && (request.resource.data.votes.diff(resource.data.votes).affectedKeys()
                .hasOnly([request.auth.uid])
              || request.resource.data.votes.keys().hasAll([request.auth.uid]))
        );
      allow delete: if isAdmin();
    }
  }
}
